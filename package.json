{
  "name": "huajing-image-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "画境生图：前后端分离的单张工作台与资产批量工作台",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix web install",
    "start:server": "node scripts/launch-server.mjs",
    "start:server:rebuild": "node scripts/launch-server.mjs --rebuild",
    "start:server:dev": "node scripts/launch-server.mjs --dev",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "build:server": "npm --prefix server run build",
    "start": "npm --prefix server run start"
  }
}
